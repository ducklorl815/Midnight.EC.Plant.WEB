@model Midnight.EC.Plant.WEB.ViewModels.AdminPlantSourceCreateViewModel
@{
    ViewData["Title"] = "Admin - 新增外部來源";
}

<h1 class="mb-4">新增外部來源</h1>

@if (TempData["Info"] is string info)
{
    <div class="alert alert-info">@info</div>
}

<form asp-action="Parse" method="post" class="card shadow-sm mb-4">
    @Html.AntiForgeryToken()
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="SpeciesId" class="form-label"></label>
            <select asp-for="SpeciesId" class="form-select" asp-items="@(new SelectList(Model.SpeciesOptions, "Id", "Name"))">
                <option value="">-- 請選擇物種 --</option>
            </select>
            <span asp-validation-for="SpeciesId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Url" class="form-label"></label>
            <input asp-for="Url" class="form-control" placeholder="https://..." />
            <span asp-validation-for="Url" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="SourceType" class="form-label"></label>
                <select asp-for="SourceType" class="form-select" asp-items="Html.GetEnumSelectList<Midnight.EC.Plant.WEB.Models.Enums.SourceType>()">
                    <option value="">自動判斷</option>
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">解析</button>
        <a asp-action="Index" class="btn btn-secondary mt-3 ms-2">返回</a>
    </div>
</form>

@if (Model.Preview != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between">
            <strong>解析結果</strong>
            <span class="badge bg-@(Model.Preview.Status == Midnight.EC.Plant.WEB.Models.Enums.SourceContentStatus.Completed ? "success" : "danger")">
                @Model.Preview.Status
            </span>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Preview.ErrorMessage))
            {
                <div class="alert alert-warning">@Model.Preview.ErrorMessage</div>
            }

            <dl class="row">
                <dt class="col-sm-2">標準 URL</dt><dd class="col-sm-10">@Model.Preview.NormalizedUrl</dd>
                <dt class="col-sm-2">標題</dt><dd class="col-sm-10">@(Model.Preview.Title ?? "-")</dd>
                <dt class="col-sm-2">作者</dt><dd class="col-sm-10">@(Model.Preview.Author ?? "-")</dd>
                <dt class="col-sm-2">Parser</dt><dd class="col-sm-10">@Model.Preview.ParserType v@Model.Preview.ParserVersion</dd>
                <dt class="col-sm-2">可靠度</dt><dd class="col-sm-10">@Model.Preview.ReliabilityLevel</dd>
                <dt class="col-sm-2">Content Hash</dt><dd class="col-sm-10"><code>@Model.Preview.ContentHash</code></dd>
                <dt class="col-sm-2">Summary</dt><dd class="col-sm-10">@(Model.Preview.Summary ?? "-")</dd>
                <dt class="col-sm-2">Keywords</dt><dd class="col-sm-10">@(Model.Preview.Keywords ?? "-")</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(Model.Preview.CleanText))
            {
                <h6>CleanText</h6>
                <pre class="bg-light p-3 rounded small" style="max-height:320px;overflow:auto;">@Model.Preview.CleanText</pre>
            }

            @if (!Model.Preview.IsExisting)
            {
                <form asp-action="Create" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SpeciesId" />
                    <input type="hidden" asp-for="Url" />
                    <input type="hidden" asp-for="Title" />
                    <input type="hidden" asp-for="SourceType" />
                    <button type="submit" class="btn btn-success">儲存來源</button>
                </form>
            }
            else if (Model.Preview.ExistingSourceId.HasValue)
            {
                <a asp-action="Details" asp-route-id="@Model.Preview.ExistingSourceId" class="btn btn-outline-primary mt-3">查看既有來源</a>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
