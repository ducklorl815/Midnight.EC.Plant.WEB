@model Midnight.EC.Plant.WEB.ViewModels.AdminPlantSourceListViewModel
@{
    ViewData["Title"] = "知識庫 - 外部來源";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title mb-1">外部資料來源</h1>
        <p class="page-subtitle mb-0">物種級參考資料，供 AI 分析使用</p>
    </div>
    <a asp-action="Create" class="btn btn-plant-primary">新增來源</a>
</div>

<div class="panel mb-4">
    <div class="panel-body">
        <p class="mb-2"><strong>這是什麼？</strong>知識庫來源是物種級參考資料，不是個人植栽。</p>
        <p class="text-muted mb-0 small">多物種關聯：同一 URL 可複選多個物種，不會重複建立。</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>關聯物種（中文）</th>
            <th>標題</th>
            <th>URL</th>
            <th>類型</th>
            <th>可靠度</th>
            <th>建立時間</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Sources)
        {
            <tr>
                <td>@item.SpeciesName</td>
                <td>@(item.Title ?? "-")</td>
                <td class="text-truncate" style="max-width:280px;"><a href="@item.Url" target="_blank">@item.Url</a></td>
                <td>@item.SourceType</td>
                <td>@item.ReliabilityLevel</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">查看</a></td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Sources.Any())
{
    <div class="alert alert-info">尚無外部來源，請先新增。</div>
}
