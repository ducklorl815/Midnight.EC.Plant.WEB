@model Midnight.EC.Plant.WEB.ViewModels.AdminPlantSourceListViewModel
@{
    ViewData["Title"] = "知識庫 - 外部來源";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">外部資料來源（知識庫）</h1>
        <p class="text-muted mb-0">管理供 AI 分析參考的外部文章、YouTube 影片等資料</p>
    </div>
    <a asp-action="Create" class="btn btn-success">+ 新增來源</a>
</div>

<div class="alert alert-light border mb-4">
    <strong>這是什麼？</strong>
    知識庫來源是「物種級別」的參考資料，不是您的個人植栽。
    當您對植栽執行 AI 草況分析時，系統會依該植栽的物種，自動載入相關的外部來源內容（栽培指南、影片重點等）作為 AI 的參考依據。
    <br /><br />
    <strong>多物種關聯：</strong>一支 YouTube 影片若同時介紹多種植物，儲存時可複選多個物種，同一 URL 不會重複建立，只會追加物種關聯。
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>關聯物種（中文）</th>
            <th>標題</th>
            <th>URL</th>
            <th>類型</th>
            <th>可靠度</th>
            <th>建立時間</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Sources)
        {
            <tr>
                <td>@item.SpeciesName</td>
                <td>@(item.Title ?? "-")</td>
                <td class="text-truncate" style="max-width:280px;"><a href="@item.Url" target="_blank">@item.Url</a></td>
                <td>@item.SourceType</td>
                <td>@item.ReliabilityLevel</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">查看</a></td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Sources.Any())
{
    <div class="alert alert-info">尚無外部來源，請先新增。</div>
}
