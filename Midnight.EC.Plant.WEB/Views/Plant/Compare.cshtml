@model Midnight.EC.Plant.WEB.ViewModels.PlantCompareViewModel
@{
    ViewData["Title"] = "多植物比較";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">&larr; 返回列表</a>
</div>

<h1 class="mb-4">多植物比較</h1>

<form asp-action="Compare" method="post" class="card shadow-sm mb-4">
    @Html.AntiForgeryToken()
    <div class="card-body">
        <p class="text-muted">請選擇至少 2 盆植物進行健康度、澆水與環境趨勢比較。</p>
        <div class="row g-2 mb-3">
            @foreach (var plant in Model.PlantOptions)
            {
                <div class="col-md-4">
                    <div class="form-check border rounded p-2">
                        <input class="form-check-input" type="checkbox" name="SelectedPlantIds" value="@plant.Id" id="plant-@plant.Id" @(plant.IsSelected ? "checked" : null) />
                        <label class="form-check-label" for="plant-@plant.Id">
                            <strong>@plant.Name</strong>
                            <span class="text-muted d-block small">@plant.SpeciesName</span>
                        </label>
                    </div>
                </div>
            }
        </div>
        <button type="submit" class="btn btn-primary">開始比較</button>
    </div>
</form>

@if (Model.Result != null && Model.Result.Items.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header"><strong>健康度比較</strong></div>
        <div class="card-body">
            <canvas id="compareHealthChart" height="120"></canvas>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>植物</th>
                    <th>物種</th>
                    <th>位置</th>
                    <th>健康度</th>
                    <th>最近澆水</th>
                    <th>30日澆水</th>
                    <th>平均溫度</th>
                    <th>平均濕度</th>
                    <th>成長趨勢</th>
                    <th>待處理提醒</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Result.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@item.PlantId">@item.Name</a></td>
                        <td>@item.SpeciesName</td>
                        <td>@(item.Location ?? "-")</td>
                        <td>@(item.LatestHealthScore?.ToString() ?? "-")</td>
                        <td>@(item.LastWateringDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                        <td>@item.WateringCount30Days 次</td>
                        <td>@(item.AvgTemperature?.ToString("0.#") ?? "-")</td>
                        <td>@(item.AvgHumidity?.ToString("0.#") ?? "-")</td>
                        <td>@(item.GrowthTrend ?? "-")</td>
                        <td>@item.ActiveReminderCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.SelectedPlantIds.Length > 0 && Model.SelectedPlantIds.Length < 2)
{
    <div class="alert alert-warning">請至少選擇 2 盆植物。</div>
}

@section Scripts {
    @if (Model.Result != null && Model.Result.Items.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                if (typeof Chart === 'undefined') return;
                new Chart(document.getElementById('compareHealthChart'), {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Model.Result.HealthScoreLabelsJson),
                        datasets: [{
                            label: '最新健康度',
                            data: @Html.Raw(Model.Result.HealthScoresJson),
                            backgroundColor: '#198754'
                        }]
                    },
                    options: {
                        scales: { y: { min: 0, max: 100 } },
                        plugins: { legend: { display: false } }
                    }
                });
            })();
        </script>
    }
}
