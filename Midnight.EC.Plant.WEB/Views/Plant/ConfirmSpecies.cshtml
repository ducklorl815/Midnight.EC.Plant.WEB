@model Midnight.EC.Plant.WEB.ViewModels.ConfirmSpeciesViewModel

@{
    ViewData["Title"] = "確認物種";
}

<div class="page-header mb-3">
    <h1 class="page-title">確認物種</h1>
    <p class="page-subtitle">
        暱稱「@Model.Draft.NickName」／中文名「@Model.Draft.ChineseName」。
        @(Model.Candidates.Count == 0 ? "沒有候選，可改中文名／學名再查，或先建檔。" : "請確認後寫入（確認時會寫滿照護知識）。")
    </p>
</div>

<nav class="flow-steps" aria-label="新增步驟">
    <span class="flow-step flow-step-done"><span class="flow-step-num">✓</span> 基本＋環境</span>
    <span class="flow-step flow-step-active"><span class="flow-step-num">2</span> 確認物種</span>
    <span class="flow-step"><span class="flow-step-num">3</span> 完成</span>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-9">
        @if (Model.MismatchWarnings.Any())
        {
            <div class="alert alert-warning mb-4">
                <strong>實際環境與物種建議有落差</strong>
                <ul class="mb-2 mt-2">
                    @foreach (var w in Model.MismatchWarnings)
                    {
                        <li>@w</li>
                    }
                </ul>
                <p class="mb-0 small">請勾選「我知道」後再建立；或返回上一步調整實際環境。</p>
            </div>
        }

        @if (Model.Candidates.Count > 0)
        {
            <form asp-action="ConfirmSpecies" method="post" class="mb-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <partial name="_CreateDraftHidden" model="Model.Draft" />

                <div class="row g-3 mb-3">
                    @for (var i = 0; i < Model.Candidates.Count; i++)
                    {
                        var c = Model.Candidates[i];
                        <div class="col-md-4">
                            <label class="card h-100 p-3 species-candidate @(Model.SelectedIndex == i ? "border-primary" : "")" style="cursor:pointer;">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="SelectedIndex" value="@i"
                                           @(Model.SelectedIndex == i || (Model.SelectedIndex == null && i == 0) ? "checked" : null) />
                                    <span class="fw-semibold">@c.ScientificName</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                {
                                    <img src="@c.ImageUrl" alt="@c.ScientificName" class="img-fluid rounded mb-2" style="max-height:140px;object-fit:cover;width:100%;" />
                                }
                                <div class="small text-muted">
                                    @if (!string.IsNullOrWhiteSpace(c.CommonName)) { <div>俗名：@c.CommonName</div> }
                                    @if (!string.IsNullOrWhiteSpace(c.Family) || !string.IsNullOrWhiteSpace(c.Genus))
                                    {
                                        <div>科屬：@c.Family @c.Genus</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.IdentificationHint))
                                    {
                                        <div class="mt-1">@c.IdentificationHint</div>
                                    }
                                    <div>來源：@c.Provider</div>
                                </div>
                                <input type="hidden" name="Candidates[@i].ScientificName" value="@c.ScientificName" />
                                <input type="hidden" name="Candidates[@i].CommonName" value="@c.CommonName" />
                                <input type="hidden" name="Candidates[@i].ChineseName" value="@c.ChineseName" />
                                <input type="hidden" name="Candidates[@i].Genus" value="@c.Genus" />
                                <input type="hidden" name="Candidates[@i].Family" value="@c.Family" />
                                <input type="hidden" name="Candidates[@i].ImageUrl" value="@c.ImageUrl" />
                                <input type="hidden" name="Candidates[@i].IdentificationHint" value="@c.IdentificationHint" />
                                <input type="hidden" name="Candidates[@i].TaxonId" value="@c.TaxonId" />
                                <input type="hidden" name="Candidates[@i].Provider" value="@c.Provider" />
                                <input type="hidden" name="Candidates[@i].SourceType" value="@c.SourceType" />
                                <input type="hidden" name="Candidates[@i].SourceId" value="@c.SourceId" />
                            </label>
                        </div>
                    }
                </div>

                @if (Model.MismatchWarnings.Any())
                {
                    <div class="form-check mb-3">
                        <input asp-for="AcknowledgeMismatch" class="form-check-input" />
                        <label asp-for="AcknowledgeMismatch" class="form-check-label"></label>
                    </div>
                }

                <button type="submit" class="btn btn-plant-primary">確認此物種並建立</button>
            </form>
            <form asp-action="BackToCreate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <partial name="_CreateDraftHidden" model="Model.Draft" />
                <button type="submit" class="btn btn-outline-secondary">返回修改</button>
            </form>
        }
        else
        {
            <div class="empty-state mb-4">
                <div class="empty-state-icon">🔍</div>
                <h2 class="h5">找不到候選物種</h2>
                <p class="text-muted mb-0">可改中文名／學名再查，或先建檔、知識之後補。</p>
            </div>
        }

        <section class="panel mb-3">
            <div class="panel-header"><strong>中文／學名再查</strong></div>
            <div class="panel-body">
                <form asp-action="SearchByScientificName" method="post" class="row g-2 align-items-end">
                    <partial name="_CreateDraftHidden" model="Model.Draft" />
                    <div class="col-md-6">
                        <label asp-for="ManualChineseName" class="form-label"></label>
                        <input asp-for="ManualChineseName" class="form-control" placeholder="例如：縞馬蘿藦" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ManualScientificName" class="form-label"></label>
                        <input asp-for="ManualScientificName" class="form-control" placeholder="進階：Huernia zebrina" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-emphasis">再查一次</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="panel panel-quiet">
            <div class="panel-header"><strong>先建檔、知識之後補</strong></div>
            <div class="panel-body">
                <p class="text-muted small mb-3">斷網或對不到物種時可用。會保存實際環境但不打 AI；之後在詳情頁「重新產生照護知識」。</p>
                <form asp-action="CreateWithoutSpecies" method="post">
                    <partial name="_CreateDraftHidden" model="Model.Draft" />
                    <button type="submit" class="btn btn-outline-secondary">略過物種，直接建立</button>
                </form>
            </div>
        </section>
    </div>
</div>
