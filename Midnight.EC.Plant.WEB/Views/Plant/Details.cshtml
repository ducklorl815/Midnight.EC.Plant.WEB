@model Midnight.EC.Plant.WEB.ViewModels.PlantDetailViewModel
@using Midnight.EC.Plant.WEB.Models.External
@{
    ViewData["Title"] = Model.DisplayName;
    var locationText = Model.Location;
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <a asp-action="Index" class="text-decoration-none text-muted">&larr; 返回我的植栽</a>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">編輯</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('確定刪除此植栽？');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
        </form>
    </div>
</div>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}
@if (TempData["Warning"] is string warningMessage)
{
    <div class="alert alert-warning">@warningMessage</div>
}
@if (TempData["Flash"] is string flashMessage)
{
    <div class="alert alert-success">@flashMessage</div>
}
@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<section class="plant-hero">
    <div class="plant-hero-cover">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImagePath))
        {
            <img src="@Model.CoverImagePath" alt="@Model.Name 封面" />
        }
        else
        {
            <div class="plant-hero-placeholder">
                <span>🌿</span>
                <small>尚未設定封面</small>
            </div>
        }
    </div>
    <div class="plant-hero-info">
        <h1 class="plant-hero-title">@Model.DisplayName</h1>
        <p class="plant-hero-meta mb-1">
            @if (!string.IsNullOrWhiteSpace(Model.SpeciesChineseName))
            {
                @Model.SpeciesChineseName
            }
            else if (!string.IsNullOrWhiteSpace(Model.SpeciesName))
            {
                @Model.SpeciesName
            }
            else
            {
                <text>未知物種</text>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.SpeciesScientificName))
        {
            <p class="plant-hero-scientific">@Model.SpeciesScientificName</p>
        }
        @if (!string.IsNullOrWhiteSpace(locationText))
        {
            <p class="plant-hero-location">@locationText</p>
        }
        <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
            @if (Model.DaysSinceLastWatering.HasValue)
            {
                <span class="status-pill status-pill-action">距上次澆水 @Model.DaysSinceLastWatering 天</span>
            }
            else
            {
                <span class="status-pill status-pill-muted">尚無澆水紀錄</span>
            }
            @if (Model.LatestHealthScore.HasValue)
            {
                <span class="health-badge health-badge-@(Model.LatestHealthScore >= 70 ? "good" : Model.LatestHealthScore >= 50 ? "warn" : "bad")">
                    健康度 @Model.LatestHealthScore
                </span>
            }
        </div>
        <div class="plant-hero-actions">
            <a href="#log-entry" class="btn btn-sm btn-plant-primary">記一筆</a>
            <a asp-action="EditEnvironment" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">補實際環境</a>
        </div>
    </div>
</section>

<section id="log-entry" class="panel mb-4">
    <div class="panel-header">
        <strong>記一筆</strong>
        <span class="text-muted small">日期可今天或過去 · 照片可選</span>
    </div>
    <div class="panel-body">
        <form asp-action="SaveLogEntry" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-3">
                    <label asp-for="LogEntry.LogDate" class="form-label"></label>
                    <input asp-for="LogEntry.LogDate" class="form-control" type="date" />
                </div>
                <div class="col-md-2">
                    <div class="form-check mt-4">
                        <input asp-for="LogEntry.Watered" class="form-check-input" />
                        <label asp-for="LogEntry.Watered" class="form-check-label fw-semibold">澆水</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-check mt-4">
                        <input asp-for="LogEntry.Fertilized" class="form-check-input" />
                        <label asp-for="LogEntry.Fertilized" class="form-check-label">施肥</label>
                    </div>
                </div>
                <div class="col-md-5">
                    <label asp-for="LogEntry.Note" class="form-label"></label>
                    <input asp-for="LogEntry.Note" class="form-control" placeholder="可選：草況一句話" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">照片（可選，可多張）</label>
                <input type="file" name="photos" class="form-control" accept="image/*" multiple />
            </div>
            <button type="submit" class="btn btn-plant-primary">存檔</button>
            <span class="text-muted small ms-2">至少勾選澆水／施肥，或寫備註／上傳照片</span>
        </form>

        @if (Model.Timeline.Any())
        {
            <hr class="my-4" />
            <div class="small text-muted mb-2">近期時間軸（澆水／施肥／備註）</div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Model.Timeline.Take(30))
                {
                    <li class="list-group-item px-0 d-flex justify-content-between gap-3">
                        <div>
                            <span class="fw-semibold">@item.Title</span>
                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <span class="text-muted">· @item.Summary</span>
                            }
                        </div>
                        <div class="text-muted small text-nowrap">@item.EventDate.ToString("yyyy/MM/dd")</div>
                    </li>
                }
            </ul>
        }
    </div>
</section>

<section class="panel mb-4">
    <div class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <strong>照片牆</strong>
        <span class="text-muted small">上傳後可對單張做 AI 分析</span>
    </div>
    <div class="panel-body">
        <form asp-action="UploadPhoto" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="upload-panel mb-4">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">選擇照片</label>
                    <input type="file" name="photoFile" accept="image/*" class="form-control" required />
                </div>
                <div class="col-md-5">
                    <label asp-for="NewPhoto.Note" class="form-label"></label>
                    <input asp-for="NewPhoto.Note" class="form-control" placeholder="例如：葉片發黃、疑似缺肥、新長側芽" />
                </div>
                <div class="col-md-3">
                    <div class="form-check mb-2">
                        <input asp-for="NewPhoto.SetAsCover" class="form-check-input" />
                        <label asp-for="NewPhoto.SetAsCover" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-plant-primary w-100">上傳照片</button>
                </div>
            </div>
        </form>

        @if (!Model.Photos.Any())
        {
            <p class="text-muted mb-0">尚無照片。上傳後會出現在照片牆，也可做 AI 草況分析。</p>
        }
        else
        {
            <div class="photo-grid">
                @foreach (var photo in Model.Photos)
                {
                    <article class="photo-card">
                        <div class="photo-card-image">
                            <img src="@photo.PublicPath" alt="植栽照片" />
                            @if (photo.IsCover)
                            {
                                <span class="photo-cover-badge">封面</span>
                            }
                        </div>
                        <div class="photo-card-body">
                            <form asp-action="UpdatePhotoNote" asp-route-id="@Model.Id" asp-route-imageId="@photo.Id" method="post" class="photo-note-form mb-2">
                                @Html.AntiForgeryToken()
                                <label class="form-label small mb-1">備註</label>
                                <div class="input-group input-group-sm">
                                    <input name="Note" class="form-control" value="@photo.Note" placeholder="例如：葉片發黃、新長側芽" />
                                    <button type="submit" class="btn btn-outline-secondary">儲存</button>
                                </div>
                            </form>
                            <div class="small text-muted mb-2">@photo.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>

                            @if (photo.LatestAnalysis != null)
                            {
                                <div class="photo-analysis-result">
                                    <div class="fw-semibold small mb-1">
                                        AI 分析
                                        @if (photo.LatestAnalysis.HealthScore.HasValue)
                                        {
                                            <span class="health-badge health-badge-sm health-badge-@(photo.LatestAnalysis.HealthScore >= 70 ? "good" : photo.LatestAnalysis.HealthScore >= 50 ? "warn" : "bad")">
                                                @photo.LatestAnalysis.HealthScore
                                            </span>
                                        }
                                    </div>
                                    <p class="small mb-0">@photo.LatestAnalysis.Summary</p>
                                    @{
                                        FertilizerRecipeDto? photoFert = null;
                                        if (!string.IsNullOrWhiteSpace(photo.LatestAnalysis.ResultJson))
                                        {
                                            var parsedAnalysis = Midnight.EC.Plant.WEB.Utility.Json.JsonHelper.Deserialize<Midnight.EC.Plant.WEB.Models.AI.PlantAnalysisResultDto>(photo.LatestAnalysis.ResultJson);
                                            photoFert = parsedAnalysis?.FertilizerAdvice;
                                        }
                                    }
                                    @if (photoFert != null)
                                    {
                                        ViewBag.FertilizerBlockTitle = "施肥建議（可製作水肥）";
                                        @await Html.PartialAsync("_FertilizerRecipeGuide", photoFert)
                                    }
                                    else if (!string.IsNullOrWhiteSpace(photo.LatestAnalysis.FertilizerAdviceText))
                                    {
                                        <div class="fertilizer-recipe mt-2">
                                            <div class="fertilizer-recipe-title">施肥建議</div>
                                            <div class="small mb-0">@photo.LatestAnalysis.FertilizerAdviceText</div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="photo-card-actions">
                                <button type="button" class="btn btn-sm btn-plant-primary analyze-photo-btn" data-plant-id="@Model.Id" data-image-id="@photo.Id">
                                    AI 分析
                                </button>
                                @if (!photo.IsCover)
                                {
                                    <form asp-action="SetCoverPhoto" asp-route-id="@Model.Id" asp-route-imageId="@photo.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">設封面</button>
                                    </form>
                                }
                                <form asp-action="DeletePhoto" asp-route-id="@Model.Id" asp-route-imageId="@photo.Id" method="post" class="d-inline" onsubmit="return confirm('確定刪除此照片？');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                                </form>
                            </div>
                            <div class="photo-analysis-status small text-muted d-none" data-image-id="@photo.Id"></div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@if (Model.Reminders.Any())
{
    <section class="panel panel-reminder mb-4">
        <div class="panel-header"><strong>智慧提醒</strong></div>
        <div class="panel-body p-0">
            <ul class="list-group list-group-flush">
                @foreach (var reminder in Model.Reminders)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="fw-semibold @(reminder.IsOverdue ? "text-danger" : string.Empty)">
                                @reminder.Title
                            </div>
                            @if (!string.IsNullOrWhiteSpace(reminder.Message))
                            {
                                <div class="small text-muted mt-1">@reminder.Message</div>
                            }
                            <div class="small text-muted">到期：@reminder.DueDate.ToString("yyyy/MM/dd")</div>
                        </div>
                        <form asp-action="DismissReminder" asp-route-id="@Model.Id" asp-route-reminderId="@reminder.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">略過</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </section>
}

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <section class="panel h-100">
            <div class="panel-header">
                <strong>物種照護知識</strong>
                <span class="badge-soft">外部來源</span>
            </div>
            <div class="panel-body">
                @{
                    var speciesGuide = CareGuideJson.TryParseSpeciesGuide(Model.Knowledge?.ExternalCareGuide);
                    ViewBag.LegacyCareGuide = speciesGuide == null ? Model.Knowledge?.ExternalCareGuide : null;
                    var suggestedDays = Model.CareSuggestions.SuggestedWateringIntervalDays;
                    var myDays = Model.Profile.WateringIntervalDays;
                }
                <div class="care-facts mb-3">
                    @if (suggestedDays.HasValue)
                    {
                        <div><span>建議澆水</span>每 @suggestedDays 天</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.Knowledge?.WaterRequirement))
                    {
                        <div><span>澆水</span>@Model.Knowledge.WaterRequirement</div>
                    }
                    @if (myDays.HasValue)
                    {
                        <div><span>我的澆水週期</span>每 @myDays 天</div>
                    }
                </div>

                @if (speciesGuide != null || !string.IsNullOrWhiteSpace(Model.Knowledge?.ExternalCareGuide))
                {
                    @await Html.PartialAsync("_SpeciesCareGuide", speciesGuide)
                }
                else if (Model.Knowledge != null && !Model.Knowledge.IsSparse)
                {
                    <div class="care-facts">
                        @if (!string.IsNullOrWhiteSpace(Model.Knowledge.LightRequirement)) { <div><span>光照</span>@Model.Knowledge.LightRequirement</div> }
                        @if (!string.IsNullOrWhiteSpace(Model.Knowledge.WaterRequirement) && !suggestedDays.HasValue) { <div><span>澆水</span>@Model.Knowledge.WaterRequirement</div> }
                        @if (!string.IsNullOrWhiteSpace(Model.Knowledge.SoilRequirement)) { <div><span>土壤</span>@Model.Knowledge.SoilRequirement</div> }
                        @if (!string.IsNullOrWhiteSpace(Model.Knowledge.FertilizerRequirement)) { <div><span>施肥</span>@Model.Knowledge.FertilizerRequirement</div> }
                        @if (!string.IsNullOrWhiteSpace(Model.Knowledge.TemperatureRange)) { <div><span>溫度</span>@Model.Knowledge.TemperatureRange</div> }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-3">尚無官方說明，可在下方進階區同步外部資料。</p>
                }

                @await Html.PartialAsync("_EnvironmentAdvice", Model.Profile)

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr class="my-3" />
                    <div class="small text-muted mb-1">我的備註</div>
                    <p class="mb-0">@Model.Description</p>
                }

                <div class="mt-3">
                    <a asp-action="EditEnvironment" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">編輯實際環境</a>
                </div>
            </div>
        </section>
    </div>

    <div class="col-lg-5">
        <p class="section-label">進階</p>
        <section class="panel mb-4">
            <div class="panel-header"><strong>同步官方資料</strong></div>
            <div class="panel-body">
                <form asp-action="SyncKnowledge" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <label asp-for="SyncKnowledge.SpeciesKeyword" class="form-label"></label>
                    <input asp-for="SyncKnowledge.SpeciesKeyword" class="form-control mb-2" placeholder="例如：玉露錦" />
                    <button type="submit" class="btn btn-outline-emphasis btn-sm w-100">同步外部 API</button>
                </form>
            </div>
        </section>

        <section class="panel">
            <div class="panel-header"><strong>個人化設定</strong></div>
            <div class="panel-body">
                <form asp-action="SaveProfile" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-2">
                        <div class="col-6">
                            <label asp-for="Profile.WateringIntervalDays" class="form-label small"></label>
                            <input asp-for="Profile.WateringIntervalDays" class="form-control form-control-sm" type="number" min="1" />
                        </div>
                        <div class="col-6">
                            <label asp-for="Profile.FertilizingIntervalDays" class="form-label small"></label>
                            <input asp-for="Profile.FertilizingIntervalDays" class="form-control form-control-sm" type="number" min="1" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Profile.PersonalCareNotes" class="form-label small"></label>
                            <input asp-for="Profile.PersonalCareNotes" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-brand btn-sm mt-3">儲存設定</button>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.analyze-photo-btn').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    const plantId = btn.dataset.plantId;
                    const imageId = btn.dataset.imageId;
                    const statusEl = document.querySelector('.photo-analysis-status[data-image-id="' + imageId + '"]');
                    btn.disabled = true;
                    if (statusEl) {
                        statusEl.classList.remove('d-none');
                        statusEl.textContent = 'AI 分析中，請稍候…';
                    }

                    const response = await fetch('/Plant/AnalyzePhoto?id=' + plantId + '&imageId=' + imageId, { method: 'POST' });
                    if (!response.ok) {
                        if (statusEl) statusEl.textContent = '分析啟動失敗。';
                        btn.disabled = false;
                        return;
                    }

                    const job = await response.json();
                    const timer = setInterval(async function () {
                        const statusResponse = await fetch('/Plant/AnalysisStatus/' + plantId + '?jobId=' + job.id);
                        if (!statusResponse.ok) return;
                        const status = await statusResponse.json();
                        if (status.status === 2) {
                            clearInterval(timer);
                            window.location.reload();
                        } else if (status.status === 3) {
                            clearInterval(timer);
                            if (statusEl) statusEl.textContent = status.errorMessage || 'AI 分析失敗。';
                            btn.disabled = false;
                        }
                    }, 2000);
                });
            });
        })();
    </script>
}
