@model Midnight.EC.Plant.WEB.ViewModels.EditPlantViewModel

@{
    ViewData["Title"] = "編輯植栽";
}

<div class="mb-3">
    <a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-muted">&larr; 返回植栽詳情</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <section class="panel">
            <div class="panel-header">
                <strong>編輯植栽</strong>
            </div>
            <div class="panel-body">
                <div class="alert alert-light border mb-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div>
                            <div class="small text-muted mb-1">物種</div>
                            <div>@(string.IsNullOrWhiteSpace(Model.SpeciesName) ? "尚未確認" : Model.SpeciesName)</div>
                            @if (!string.IsNullOrWhiteSpace(Model.SpeciesScientificName))
                            {
                                <div class="small text-muted fst-italic">@Model.SpeciesScientificName</div>
                            }
                        </div>
                        <a asp-action="ReselectSpecies" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-emphasis">重選物種</a>
                    </div>
                    <div class="form-text mt-2 mb-0">學名選錯可由此重選；確認後會同步知識並重算環境適配。</div>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NickName" class="form-label"></label>
                        <input asp-for="NickName" class="form-control" placeholder="例如：小烏龜" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="例如：客廳窗台" />
                            <div class="form-text">選填；與「實際位置類型」不同。</div>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-plant-primary">儲存變更</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">取消</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
