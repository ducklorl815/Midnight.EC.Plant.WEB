@model Midnight.EC.Plant.WEB.ViewModels.PageComposerViewModel

@{
    ViewData["Title"] = "首頁";
    ViewData["HomeChrome"] = true;
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-warning m-3 mb-0">@err</div>
}
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success m-3 mb-0">@ok</div>
}

<link rel="stylesheet" href="~/css/page-composer.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/plant-effect-image.css" asp-append-version="true" />

@await Html.PartialAsync("Modules/_PageShell", Model)

@section Scripts {
    <script src="~/js/page-composer-chrome.js" asp-append-version="true"></script>
    <script src="~/js/page-composer-carousel.js" asp-append-version="true"></script>
}
