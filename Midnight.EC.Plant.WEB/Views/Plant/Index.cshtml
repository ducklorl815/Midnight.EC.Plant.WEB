@model Midnight.EC.Plant.WEB.ViewModels.PlantListViewModel

@{
    ViewData["Title"] = "首頁";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title mb-1">首頁</h1>
        <p class="page-subtitle mb-0">置頂待辦：逾期澆水 → 催補日期 → 資料未完成；下方植物牆。</p>
    </div>
    <a asp-action="Create" class="btn btn-plant-primary">+ 新增植栽</a>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-warning">@err</div>
}
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

@if (!Model.Plants.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">🌱</div>
        <h2>尚未建立任何植物</h2>
        <p class="text-muted">新增第一盆；想到澆水再建檔即可。</p>
        <a asp-action="Create" class="btn btn-plant-primary">新增植栽</a>
    </div>
}
else
{
    <section class="panel mb-4">
        <div class="panel-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong>① 澆水逾期（已經超過提醒週期）</strong>
            <span class="text-muted small">@(Model.OverdueWatering.Count) 盆 · 沒澆越久越上面</span>
        </div>
        <div class="panel-body">
            @if (!Model.OverdueWatering.Any())
            {
                <p class="text-muted mb-0">目前沒有逾期澆水。</p>
            }
            else
            {
                <form asp-action="BatchWater" method="post">
                    @Html.AntiForgeryToken()
                    <div class="table-responsive">
                        <table class="table align-middle mb-3">
                            <thead>
                                <tr>
                                    <th style="width:2.5rem;"></th>
                                    <th>暱稱</th>
                                    <th>已經幾天沒澆</th>
                                    <th>提醒週期</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var p in Model.OverdueWatering)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input" name="plantIds" value="@p.Id" checked />
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@p.Id">@p.DisplayName</a>
                                        @if (!string.IsNullOrWhiteSpace(p.SpeciesChineseName))
                                        {
                                            <div class="small text-muted">@p.SpeciesChineseName</div>
                                        }
                                    </td>
                                    <td class="fw-semibold text-danger">已經 @(p.DaysSinceLastWatering) 天沒澆</td>
                                    <td>每 @p.WateringIntervalDays 天</td>
                                    <td><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">單盆</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <button type="submit" class="btn btn-plant-primary">批次已澆水（整批記今天）</button>
                    <span class="text-muted small ms-2">不勾選 = 略過（仍留在逾期）</span>
                </form>
            }
        </div>
    </section>

    <section class="panel mb-4">
        <div class="panel-header">
            <strong>② 催補上次澆水日</strong>
        </div>
        <div class="panel-body">
            @if (!Model.MissingWateringDate.Any())
            {
                <p class="text-muted mb-0">沒有缺澆水起點的盆。</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var p in Model.MissingWateringDate)
                    {
                        <div class="list-group-item px-0">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold">@p.DisplayName</a>
                                    <div class="small text-muted">不進逾期計算，請先補日期</div>
                                </div>
                                <form asp-action="SetLastWateringDate" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="plantId" value="@p.Id" />
                                    <input type="date" name="lastWateringDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">儲存</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="panel mb-4">
        <div class="panel-header">
            <strong>③ 資料未完成</strong>
            <span class="text-muted small ms-2">點進去先補環境（C 完成後）</span>
        </div>
        <div class="panel-body">
            @if (!Model.IncompleteData.Any())
            {
                <p class="text-muted mb-0">沒有待補資料（或環境欄位尚未啟用）。</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var p in Model.IncompleteData)
                    {
                        <li class="mb-2">
                            <a asp-action="EditEnvironment" asp-route-id="@p.Id">@p.DisplayName</a>
                            @if (p.KnowledgeIncomplete)
                            {
                                <span class="badge text-bg-warning ms-1">知識未完成</span>
                            }
                            @if (p.EnvironmentIncomplete)
                            {
                                <span class="badge text-bg-secondary ms-1">環境未完成</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    <h2 class="h5 mb-3">植物牆</h2>
    <div class="plant-grid">
        @foreach (var plant in Model.Plants)
        {
            <article class="plant-card">
                <a asp-action="Details" asp-route-id="@plant.Id" class="plant-card-link">
                    <div class="plant-card-cover">
                        @if (!string.IsNullOrWhiteSpace(plant.CoverImagePath))
                        {
                            <img src="@plant.CoverImagePath" alt="@plant.DisplayName" />
                        }
                        else
                        {
                            <div class="plant-card-cover-placeholder">🌿</div>
                        }
                    </div>
                    <div class="plant-card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                            <h3 class="plant-card-title">@plant.DisplayName</h3>
                            @if (plant.LatestHealthScore.HasValue)
                            {
                                <span class="health-badge health-badge-sm health-badge-@(plant.LatestHealthScore >= 70 ? "good" : plant.LatestHealthScore >= 50 ? "warn" : "bad")">
                                    @plant.LatestHealthScore
                                </span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(plant.SpeciesChineseName))
                        {
                            <p class="plant-card-meta">@plant.SpeciesChineseName</p>
                        }
                        @if (plant.DaysSinceLastWatering.HasValue)
                        {
                            <div class="plant-card-watering">已經 @plant.DaysSinceLastWatering 天沒澆</div>
                        }
                        else
                        {
                            <div class="plant-card-watering plant-card-watering-none">尚無澆水紀錄</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(plant.ActualLightLabel))
                        {
                            <div class="small text-muted">日照：@plant.ActualLightLabel</div>
                        }
                        <div class="mt-1">
                            @if (plant.KnowledgeIncomplete)
                            {
                                <span class="badge text-bg-warning">知識未完成</span>
                            }
                            @if (plant.EnvironmentIncomplete)
                            {
                                <span class="badge text-bg-secondary">環境未完成</span>
                            }
                        </div>
                    </div>
                </a>
                <div class="plant-card-footer">
                    <a asp-action="Edit" asp-route-id="@plant.Id" class="btn btn-sm btn-outline-secondary">編輯</a>
                    <form asp-action="Delete" asp-route-id="@plant.Id" method="post" class="d-inline" onsubmit="return confirm('確定封存此植栽？');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">封存</button>
                    </form>
                </div>
            </article>
        }
    </div>
}
