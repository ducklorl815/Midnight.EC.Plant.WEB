@model Midnight.EC.Plant.WEB.ViewModels.PlantListPageViewModel
@{
    ViewData["Title"] = "植栽清單";
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-warning">@err</div>
}
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">植栽清單</h1>
        <p class="text-muted small mb-0">各盆暱稱、封面與健康度。</p>
    </div>
    <a class="btn btn-sm btn-outline-secondary plant-list-add" asp-action="Create">新增植栽</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-light border">尚無植栽。<a asp-action="Create">立刻新增一盆</a></div>
}
else
{
    <div class="plant-card-grid">
        @foreach (var item in Model.Items)
        {
            <a class="plant-card" asp-action="Details" asp-route-id="@item.PlantId">
                @if (!string.IsNullOrWhiteSpace(item.CoverImagePath))
                {
                    <img src="@item.CoverImagePath" alt="" class="plant-card-cover" />
                }
                else
                {
                    <div class="plant-card-cover plant-card-cover-empty" aria-hidden="true"></div>
                }
                <span class="plant-card-body">
                    <span class="plant-card-name">@item.DisplayName</span>
                    @if (item.LatestHealthScore.HasValue)
                    {
                        var score = item.LatestHealthScore.Value;
                        var badge = score >= 70 ? "good" : score >= 50 ? "warn" : "bad";
                        <span class="health-badge health-badge-@badge">健康度 @score</span>
                    }
                    else
                    {
                        <span class="plant-card-meta">尚無健康度</span>
                    }
                </span>
            </a>
        }
    </div>
}
