@model Midnight.EC.Plant.WEB.ViewModels.ReselectSpeciesViewModel

@{
    ViewData["Title"] = "重選物種";
}

<div class="mb-3">
    <a asp-action="Edit" asp-route-id="@Model.PlantId" class="text-decoration-none text-muted">&larr; 返回編輯</a>
</div>

<div class="page-header mb-3">
    <h1 class="page-title">重選物種</h1>
    <p class="page-subtitle">
        「@Model.DisplayName」／中文名「@Model.ChineseName」。
        以中文找種為主；確認後會寫滿物種照護知識。
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @if (Model.MismatchWarnings.Any())
        {
            <div class="alert alert-warning mb-4">
                <strong>實際環境與物種建議有落差</strong>
                <ul class="mb-2 mt-2">
                    @foreach (var w in Model.MismatchWarnings)
                    {
                        <li>@w</li>
                    }
                </ul>
                <p class="mb-0 small">請勾選「我知道」後再確認；或先去編輯實際環境。</p>
            </div>
        }

        <section class="panel mb-3">
            <div class="panel-header"><strong>中文找種</strong></div>
            <div class="panel-body">
                <form asp-action="SearchReselectByScientificName" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PlantId" />
                    <input type="hidden" asp-for="DisplayName" />
                    <div class="col-md-8">
                        <label asp-for="ChineseName" class="form-label"></label>
                        <input asp-for="ChineseName" class="form-control" placeholder="例如：縞馬蘿藦" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-plant-primary w-100">用中文找</button>
                    </div>
                    <div class="col-12">
                        <label asp-for="ManualScientificName" class="form-label"></label>
                        <input asp-for="ManualScientificName" class="form-control" placeholder="選填，例如 Huernia zebrina；有填則優先用學名查" />
                    </div>
                </form>
            </div>
        </section>

        <section class="panel mb-4">
            <div class="panel-header"><strong>進階：照片找種</strong></div>
            <div class="panel-body">
                <form asp-action="SearchReselectByPhoto" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PlantId" />
                    <input type="hidden" asp-for="DisplayName" />
                    <input type="hidden" asp-for="ChineseName" />
                    <div class="mb-3">
                        <label class="form-label">上傳一張辨識用照片</label>
                        <input type="file" name="photoUpload" accept="image/*" class="form-control" />
                    </div>
                    @if (Model.AvailablePhotos.Any())
                    {
                        <div class="mb-3">
                            <div class="form-label">或選既有照片</div>
                            <div class="row g-2">
                                @foreach (var p in Model.AvailablePhotos)
                                {
                                    <div class="col-4 col-md-3">
                                        <label class="d-block border rounded p-1" style="cursor:pointer;">
                                            <input type="radio" name="SelectedPhotoId" value="@p.Id" class="form-check-input mb-1" />
                                            <img src="@p.Url" alt="@(p.Note ?? "照片")" class="img-fluid rounded" style="height:72px;width:100%;object-fit:cover;" />
                                            @if (p.IsCover)
                                            {
                                                <div class="small text-muted">封面</div>
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <button type="submit" class="btn btn-outline-emphasis">用照片找</button>
                </form>
            </div>
        </section>

        @if (Model.Candidates.Count > 0)
        {
            <form asp-action="ConfirmReselectSpecies" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PlantId" />
                <input type="hidden" asp-for="DisplayName" />
                <input type="hidden" asp-for="ChineseName" />

                <div class="row g-3 mb-3">
                    @for (var i = 0; i < Model.Candidates.Count; i++)
                    {
                        var c = Model.Candidates[i];
                        <div class="col-md-4">
                            <label class="card h-100 p-3 species-candidate @(Model.SelectedIndex == i ? "border-primary" : "")" style="cursor:pointer;">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="SelectedIndex" value="@i"
                                           @(Model.SelectedIndex == i || (Model.SelectedIndex == null && i == 0) ? "checked" : null) />
                                    <span class="fw-semibold">@c.ScientificName</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                {
                                    <img src="@c.ImageUrl" alt="@c.ScientificName" class="img-fluid rounded mb-2" style="max-height:140px;object-fit:cover;width:100%;" />
                                }
                                <div class="small text-muted">
                                    @if (!string.IsNullOrWhiteSpace(c.CommonName)) { <div>俗名：@c.CommonName</div> }
                                    @if (!string.IsNullOrWhiteSpace(c.Family) || !string.IsNullOrWhiteSpace(c.Genus))
                                    {
                                        <div>科屬：@c.Family @c.Genus</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.IdentificationHint))
                                    {
                                        <div class="mt-1">@c.IdentificationHint</div>
                                    }
                                    <div>來源：@c.Provider</div>
                                </div>
                                <input type="hidden" name="Candidates[@i].ScientificName" value="@c.ScientificName" />
                                <input type="hidden" name="Candidates[@i].CommonName" value="@c.CommonName" />
                                <input type="hidden" name="Candidates[@i].ChineseName" value="@c.ChineseName" />
                                <input type="hidden" name="Candidates[@i].Genus" value="@c.Genus" />
                                <input type="hidden" name="Candidates[@i].Family" value="@c.Family" />
                                <input type="hidden" name="Candidates[@i].ImageUrl" value="@c.ImageUrl" />
                                <input type="hidden" name="Candidates[@i].IdentificationHint" value="@c.IdentificationHint" />
                                <input type="hidden" name="Candidates[@i].TaxonId" value="@c.TaxonId" />
                                <input type="hidden" name="Candidates[@i].Provider" value="@c.Provider" />
                                <input type="hidden" name="Candidates[@i].SourceType" value="@c.SourceType" />
                                <input type="hidden" name="Candidates[@i].SourceId" value="@c.SourceId" />
                            </label>
                        </div>
                    }
                </div>

                @if (Model.MismatchWarnings.Any())
                {
                    <div class="form-check mb-3">
                        <input asp-for="AcknowledgeMismatch" class="form-check-input" />
                        <label asp-for="AcknowledgeMismatch" class="form-check-label"></label>
                    </div>
                }

                <button type="submit" class="btn btn-plant-primary">確認換綁並寫滿照護知識</button>
                <a asp-action="Edit" asp-route-id="@Model.PlantId" class="btn btn-outline-secondary">取消</a>
            </form>
        }
        else
        {
            <div class="empty-state mb-4">
                <div class="empty-state-icon">🔍</div>
                <h2 class="h5">尚無候選物種</h2>
                <p class="text-muted mb-0">請用上方中文找種，或進階照片／學名再查。</p>
            </div>
        }
    </div>
</div>
