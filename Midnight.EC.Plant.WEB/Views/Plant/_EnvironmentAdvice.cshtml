@using Midnight.EC.Plant.WEB.Models.External
@using Midnight.EC.Plant.WEB.Models.Enums
@model Midnight.EC.Plant.WEB.ViewModels.PlantProfileViewModel
@{
    var advice = CareGuideJson.TryParseEnvironmentAdvice(Model.AiEnvironmentAdvice);
}

@if (advice != null)
{
    <hr class="my-3" />
    <div class="care-block">
        <div class="small text-muted mb-1">針對你的實際環境</div>
        @if (!string.IsNullOrWhiteSpace(advice.FitSummary))
        {
            <div class="care-guide-text mb-2">@advice.FitSummary</div>
        }
        @if (advice.Problems.Count > 0)
        {
            <div class="care-section-label">此環境下可能出現的問題</div>
            <ol class="care-numbered-list">
                @foreach (var p in advice.Problems)
                {
                    <li>
                        @p.Text
                        @if (!string.IsNullOrWhiteSpace(p.Hint))
                        {
                            <span class="care-hint">（@p.Hint）</span>
                        }
                    </li>
                }
            </ol>
        }
        @if (advice.Adjustments.Count > 0)
        {
            <div class="care-section-label">建議調整</div>
            <ul class="care-bullet-list">
                @foreach (var a in advice.Adjustments)
                {
                    <li>@a</li>
                }
            </ul>
        }
        @if (!string.IsNullOrWhiteSpace(advice.FertilizerAdjustment))
        {
            <div class="fertilizer-recipe mt-2">
                <div class="fertilizer-recipe-title">在此環境下的施肥調整</div>
                <div class="care-guide-text">@advice.FertilizerAdjustment</div>
            </div>
        }
        <div class="small text-muted mt-2">
            依據：
            @(Model.ActualPlacement.HasValue ? PlacementTypeDisplay.ToLabel(Model.ActualPlacement) : "位置未設")
            ／@(Model.ActualLight.HasValue ? LightLevelDisplay.ToLabel(Model.ActualLight) : "日照未設")
            ／@(Model.HasRainCover == true ? "有遮雨" : Model.HasRainCover == false ? "無遮雨" : "遮雨未設")
            ／@(string.IsNullOrWhiteSpace(Model.SubstrateType) ? "介質未設" : Model.SubstrateType)
            ／@(Model.SaucerState.HasValue ? SaucerStateDisplay.ToLabel(Model.SaucerState) : "水盤未設")
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.AiEnvironmentAdvice))
{
    <hr class="my-3" />
    <div class="small text-muted mb-1">針對你的實際環境</div>
    <div class="care-guide-text">@Model.AiEnvironmentAdvice</div>
    <div class="small text-muted mt-2">
        依據：
        @(Model.ActualPlacement.HasValue ? PlacementTypeDisplay.ToLabel(Model.ActualPlacement) : "位置未設")
        ／@(Model.ActualLight.HasValue ? LightLevelDisplay.ToLabel(Model.ActualLight) : "日照未設")
        ／@(Model.HasRainCover == true ? "有遮雨" : Model.HasRainCover == false ? "無遮雨" : "遮雨未設")
        ／@(string.IsNullOrWhiteSpace(Model.SubstrateType) ? "介質未設" : Model.SubstrateType)
        ／@(Model.SaucerState.HasValue ? SaucerStateDisplay.ToLabel(Model.SaucerState) : "水盤未設")
    </div>
}
else if (Model.ActualPlacement != null || Model.ActualLight != null)
{
    <hr class="my-3" />
    <p class="text-muted mb-0 small">已有實際環境，但尚未產出適配建議。請再按一次「同步官方資料」，或重新儲存實際環境。</p>
}
