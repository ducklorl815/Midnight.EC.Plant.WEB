@{
    ViewData["Title"] = "設定";
}

<div class="page-header mb-4">
    <h1 class="page-title">設定</h1>
    <p class="page-subtitle">全站設定與尚未開放功能入口。</p>
</div>

<section class="panel mb-4">
    <div class="panel-header"><strong>可用</strong></div>
    <div class="panel-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <div class="fw-semibold">首頁拼圖</div>
                <div class="small text-muted">模組拼圖（含 Banner、植栽細節牆效果圖生成／置換）。</div>
            </div>
            <a asp-action="PageComposer" class="btn btn-sm btn-plant-primary">編輯拼圖</a>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <div class="fw-semibold">照片牆版面</div>
                <div class="small text-muted">拖移排序、調整格子寬高與縫寬（版面編輯／預覽）。</div>
            </div>
            <a asp-action="PhotoWall" class="btn btn-sm btn-outline-secondary">編輯牆</a>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <div class="fw-semibold">照護指南版面</div>
                <div class="small text-muted">詳情頁十一塊照護文章的顯示順序（全站）。</div>
            </div>
            <a asp-action="CareGuideLayout" class="btn btn-sm btn-outline-secondary">編排區塊</a>
        </div>
        <p class="text-muted mb-0">地區下拉為台灣縣市（寫死）；位置備註在各盆編輯。後續匯出／匯入會放這裡。</p>
    </div>
</section>

<section class="panel panel-quiet">
    <div class="panel-header"><strong>尚未開放</strong></div>
    <div class="panel-body">
        <ul class="list-unstyled mb-0">
            <li class="mb-2"><span class="badge-soft me-2">未完成</span>匯出／匯入</li>
            <li class="mb-2"><span class="badge-soft me-2">未完成</span>知識未完成彙總頁</li>
            <li class="mb-2"><span class="badge-soft me-2">未完成</span>月底文章</li>
            <li class="mb-2">
                <span class="badge-soft me-2">未完成</span>
                <a asp-controller="AdminPlantSource" asp-action="Index">來源解析後台</a>
                <span class="text-muted small">（先進可看，正式流程後補）</span>
            </li>
        </ul>
    </div>
</section>
