@model Midnight.EC.Plant.WEB.Models.DTOs.PageComposerModuleDto
@{
    var img = Model.Images.FirstOrDefault();
}

<section class="pc-module pc-banner @Model.Theme" data-module-type="@Model.Type" aria-label="@(string.IsNullOrWhiteSpace(Model.Title) ? "Banner" : Model.Title)">
    <div class="pc-banner-media" aria-hidden="true">
        @if (img != null && !string.IsNullOrWhiteSpace(img.Url) && !img.Missing)
        {
            <img src="@img.Url" alt="" loading="eager" />
        }
        else
        {
            <div class="pc-placeholder-visual pc-placeholder-banner"></div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Title) || !string.IsNullOrWhiteSpace(Model.Subtitle) || !string.IsNullOrWhiteSpace(Model.CtaText))
    {
        <div class="pc-banner-content">
            @if (!string.IsNullOrWhiteSpace(Model.Title))
            {
                <h1 class="pc-banner-title">@Model.Title</h1>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <p class="pc-banner-subtitle">@Model.Subtitle</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CtaText))
            {
                <a class="pc-banner-cta" href="@(Model.CtaHref ?? "#")">@Model.CtaText</a>
            }
        </div>
    }
</section>
