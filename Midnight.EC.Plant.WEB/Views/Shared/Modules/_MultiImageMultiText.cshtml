@model Midnight.EC.Plant.WEB.Models.DTOs.PageComposerModuleDto

<section class="pc-module pc-multi-text @Model.Theme" data-module-type="@Model.Type" aria-label="@Model.Title">
    <div class="pc-section-intro">
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p class="pc-eyebrow">@Model.Subtitle</p>
        }
        <h2 class="pc-heading">@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Body))
        {
            <p class="pc-body">@Model.Body</p>
        }
    </div>
    <div class="pc-multi-text-grid">
        @foreach (var item in Model.Items)
        {
            <article class="pc-multi-text-item">
                <div class="pc-multi-text-media">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                    }
                    else
                    {
                        <div class="pc-placeholder-visual pc-placeholder-sm" role="img" aria-label="@item.Title"></div>
                    }
                </div>
                <h3 class="pc-subheading">@item.Title</h3>
                @if (!string.IsNullOrWhiteSpace(item.Body))
                {
                    <p class="pc-body-sm">@item.Body</p>
                }
            </article>
        }
    </div>
</section>
