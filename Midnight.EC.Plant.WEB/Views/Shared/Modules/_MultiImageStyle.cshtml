@model Midnight.EC.Plant.WEB.Models.DTOs.PageComposerModuleDto

<section class="pc-module pc-multi-image @Model.Theme" data-module-type="@Model.Type" aria-label="@Model.Title">
    <div class="pc-section-intro">
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p class="pc-eyebrow">@Model.Subtitle</p>
        }
        <h2 class="pc-heading">@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Body))
        {
            <p class="pc-body">@Model.Body</p>
        }
    </div>
    <div class="pc-multi-image-grid">
        @foreach (var img in Model.Images)
        {
            <figure class="pc-multi-image-cell">
                @if (!string.IsNullOrWhiteSpace(img.Url))
                {
                    <img src="@img.Url" alt="@(img.Alt ?? "")" loading="lazy" />
                }
                else
                {
                    <div class="pc-placeholder-visual" role="img" aria-label="@(img.Alt ?? "圖片")"></div>
                }
                @if (!string.IsNullOrWhiteSpace(img.Alt))
                {
                    <figcaption class="pc-caption">@img.Alt</figcaption>
                }
            </figure>
        }
    </div>
</section>
