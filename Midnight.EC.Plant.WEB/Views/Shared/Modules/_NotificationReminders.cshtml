@model Midnight.EC.Plant.WEB.Models.DTOs.PageComposerModuleDto
@using Midnight.EC.Plant.WEB.Models.DTOs
@{
    var items = ViewData["NotificationReminders"] as List<NotificationReminderItemDto> ?? [];
    if (items.Count == 0)
    {
        return;
    }
}

<section class="pc-module pc-notify" data-module-type="@Model.Type" aria-label="通知提醒">
    <h2 class="pc-notify-title">@(string.IsNullOrWhiteSpace(Model.Title) ? "通知提醒" : Model.Title)</h2>
    <ul class="pc-notify-list">
        @foreach (var item in items)
        {
            <li class="pc-notify-row">
                <a class="pc-notify-link" asp-controller="Plant" asp-action="Details" asp-route-id="@item.PlantId">
                    <span class="pc-notify-headline">@item.Headline</span>
                    @if (!string.IsNullOrWhiteSpace(item.Message) && !item.ShowCompleteWater && !item.ShowCompleteFertilize)
                    {
                        <span class="pc-notify-msg">@item.Message</span>
                    }
                </a>
                @if (item.ShowCompleteWater || item.ShowCompleteFertilize)
                {
                    <form asp-controller="Plant"
                          asp-action="CompleteCareFromReminder"
                          method="post"
                          class="pc-notify-action">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="plantId" value="@item.PlantId" />
                        <input type="hidden" name="reminderId" value="@item.ReminderId" />
                        @if (item.ShowCompleteWater)
                        {
                            <button type="submit" class="btn btn-sm btn-emphasis">已澆水</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-emphasis">已施肥</button>
                        }
                    </form>
                }
            </li>
        }
    </ul>
</section>
