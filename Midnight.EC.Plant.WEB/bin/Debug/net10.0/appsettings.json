{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SetupNotes": "若要啟用完整外部植物 API 與 AI 分析，請設定 ExternalPlantApi:Trefle:ApiKey 與 AI:OpenAI:ApiKey。Development 環境建議使用 dotnet user-secrets set。",
  "ExternalPlantApi": {
    "Trefle": {
      "BaseUrl": "https://trefle.io/api/v1/",
      "ApiKey": ""
    },
    "INaturalist": {
      "BaseUrl": "https://api.inaturalist.org/v1/"
    },
    "GBIF": {
      "BaseUrl": "https://api.gbif.org/v1/"
    }
  },
  "AI": {
    "Provider": "OpenAI",
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1/",
      "ApiKey": "",
      "Model": "gpt-4o-mini"
    }
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "uploads/plants"
  }
}
